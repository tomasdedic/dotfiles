{
  "tuiMode": "regular",
  "defaultTools": [
    "+codemode"
  ],
  "enabledModels": [
    "claude-sonnet-5.5",
    "claude-opus-5.5",
    "claude-haiku-5.5",
    "gpt-6-astra",
    "gpt-6-sol",
    "general"
  ],
  "lastChangelogVersion": "1.6.0",
  "defaultProvider": "github-copilot",
  "theme": "light",
  "defaultModel": "claude-opus-5.5",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "packages": [
    "packages/chrome-cdp-skill",
    "packages/pi-k8s-ctx",
    "npm:pi-simplify",
    "npm:pi-slopchop",
    "npm:pi-memory-md",
    "npm:pi-boomerang",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-autoresearch",
    "npm:pi-add-dir",
    "../../../../opt/homebrew/lib/node_modules/@jmfederico/pi-web/dist/pi-packages/relays",
    "npm:@narumitw/pi-goal",
    "npm:pi-agents",
    "npm:@marckrenn/pi-sub-bar"
  ],
  "claudeAgentSdkProvider": {
    "overrideSystemPrompt": true
  },
  "quietStartup": false,
  "pi-memory-md": {
    "memoryDir": {
      "repoUrl": "https://github.com/tomasdedic/pimem.git",
      "localPath": "~/.pi/memory-md",
      "globalMemory": "global"
    }
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-memory-md\",\"scope\":\"user\"}": "0.1.38",
    "{\"source\":\"npm:pi-boomerang\",\"scope\":\"user\"}": "0.7.0",
    "{\"source\":\"npm:pi-autoresearch\",\"scope\":\"user\"}": "1.9.0",
    "{\"source\":\"npm:@marckrenn/pi-sub-bar\",\"scope\":\"user\"}": "1.5.0",
    "{\"source\":\"npm:@narumitw/pi-goal\",\"scope\":\"user\"}": "0.55.4"
  }
}