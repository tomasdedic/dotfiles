{
  "tuiMode": "regular",
  "defaultTools": ["+codemode"],
  "lastChangelogVersion": "1.0.4",
  "defaultProvider": "github-copilot",
  "theme": "light",
  "defaultModel": "claude-sonnet-5",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "packages": [
    "packages/pi-amplike",
    "packages/pi-sub/packages/sub-core",
    "packages/pi-sub/packages/sub-bar",
    "~/GIT/AI/pi-side-agents",
    "packages/chrome-cdp-skill",
    "packages/pi-k8s-ctx",
    "npm:pi-simplify",
    "npm:pi-slopchop",
    "npm:pi-memory-md",
    "npm:pi-boomerang",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-autoresearch",
    "npm:pi-add-dir",
    "../../../../opt/homebrew/lib/node_modules/@jmfederico/pi-web/dist/pi-packages/relays"
  ],
  "extensions": [
    "extensions/tps.ts"
  ],
  "claudeAgentSdkProvider": {
    "overrideSystemPrompt": true
  },
  "quietStartup": false,
  "pi-memory-md": {
    "memoryDir": {
      "repoUrl": "https://github.com/tomasdedic/pimem.git",
      "localPath": "~/.pi/memory-md",
      "globalMemory": "global"
    }
  }
}